{
  "realm": "mcp",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "mcp",
      "description": "Use the MCP server",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "mcp-server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "${MCP_PUBLIC_URL:http://localhost:3000/mcp}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "token-exchange-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "notes:read",
      "description": "Read notes",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" }
    },
    {
      "name": "notes:write",
      "description": "Create notes",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" }
    },
    {
      "name": "notes-api",
      "description": "Call the notes API",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "notes-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "notes-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mcp-client",
      "name": "MCP clients",
      "description": "Public client for MCP clients, such as the Inspector and Claude Code",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*", "http://127.0.0.1:*"],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["basic", "mcp"],
      "optionalClientScopes": ["notes:read", "notes:write"]
    },
    {
      "clientId": "mcp-server",
      "name": "MCP server",
      "description": "Confidential client the MCP server uses to exchange tokens for the notes API",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "mcp-server-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": { "standard.token.exchange.enabled": "true" },
      "defaultClientScopes": ["basic", "notes-api"],
      "optionalClientScopes": ["notes:read", "notes:write"]
    },
    {
      "clientId": "notes-api",
      "name": "Notes API",
      "description": "The upstream API, as a token audience",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo-password-123", "temporary": false }]
    }
  ]
}
