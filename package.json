{
  "name": "mcp-server-ts-starter",
  "version": "0.1.0",
  "description": "Production-ready MCP server in TypeScript, with stdio and Streamable HTTP, OAuth, and tool tests",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "mcpName": "io.github.opikdev/mcp-server-ts-starter",
  "bin": {
    "mcp-server-ts-starter": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/cli.ts --http",
    "build": "tsc -p tsconfig.build.json",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector node src/cli.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && .agents/check.sh && .github/scripts/check-repo-standards.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
