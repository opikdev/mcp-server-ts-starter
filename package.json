{
  "name": "mcp-server-ts-starter",
  "version": "0.4.0",
  "description": "Production-ready MCP server in TypeScript, with stdio and Streamable HTTP, OAuth, and tool tests",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "mcpName": "io.github.opikdev/mcp-server-ts-starter",
  "bin": {
    "mcp-server-ts-starter": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/cli.ts --http",
    "build": "tsc -p tsconfig.build.json",
    "inspect": "node --env-file-if-exists=.env scripts/inspect.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && .agents/check.sh && .github/scripts/check-repo-standards.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@hono/otel": "^1.3.0",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@modelcontextprotocol/client": "^2.4.0",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
