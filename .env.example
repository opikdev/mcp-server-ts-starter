# Settings for --http. Over stdio, only LOG_LEVEL applies.
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# The URL clients use. With oauth, it's also the expected token audience.
MCP_PUBLIC_URL=http://localhost:3000/mcp

# Comma-separated Host headers to accept. Defaults to localhost and the MCP_PUBLIC_URL host.
MCP_ALLOWED_HOSTS=

# oauth, token, or none. None works only on a loopback HOST.
MCP_AUTH_MODE=token

# token mode: comma-separated tokens, at least 16 characters each.
MCP_AUTH_TOKENS=dev-token-change-me-0123

# oauth mode: the issuer. The JWKS URL is discovered unless you set it.
MCP_AUTH_ISSUER=
MCP_AUTH_JWKS_URL=

# Space-separated scopes every token must have.
MCP_AUTH_SCOPES=mcp
