# Settings for --http. Over stdio, only LOG_LEVEL applies.
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# The URL clients use. With oauth, it's also the expected token audience.
MCP_PUBLIC_URL=http://localhost:3000/mcp

# Comma-separated Host headers to accept. Defaults to localhost and the MCP_PUBLIC_URL host.
MCP_ALLOWED_HOSTS=

# Comma-separated browser origins to accept. Defaults to the MCP_PUBLIC_URL origin.
MCP_ALLOWED_ORIGINS=

# oauth, token, or none. None works only on a loopback HOST.
MCP_AUTH_MODE=token

# token mode: comma-separated tokens, at least 16 characters each.
MCP_AUTH_TOKENS=dev-token-change-me-0123

# oauth mode: the issuer, https:// outside localhost. The JWKS URL is discovered unless you set it.
# For a local issuer, run compose.auth.yaml and use http://localhost:8080/realms/mcp. See docs/auth.md.
MCP_AUTH_ISSUER=
MCP_AUTH_JWKS_URL=

# Space-separated scopes every token must have.
MCP_AUTH_SCOPES=mcp

# After SIGTERM: seconds /readyz fails before the server stops accepting, then seconds requests may still run.
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30

# Set to export OpenTelemetry traces and metrics over OTLP. See docs/deploy.md.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set to turn on the notes tools, which call a REST API. See docs/upstream.md.
UPSTREAM_API_URL=
UPSTREAM_API_TOKEN=
UPSTREAM_TIMEOUT_MS=5000

# static sends UPSTREAM_API_TOKEN. exchange swaps each caller's token (RFC 8693), and needs oauth mode.
UPSTREAM_AUTH=static
UPSTREAM_AUDIENCE=
TOKEN_EXCHANGE_URL=
TOKEN_EXCHANGE_CLIENT_ID=
TOKEN_EXCHANGE_CLIENT_SECRET=
